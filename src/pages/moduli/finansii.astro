---
import Layout from "@/layouts/main.astro"
import SiteHeader from "@/components/site-header"
import SiteFooter from "@/components/site-footer.astro"
---

<Layout
  title="Модул: Финансии | Veridex ERP"
  description="Влезни и излезни фактури, трошоци поврзани со возила, вработени и тури. Сите на едно место."
>
  <SiteHeader client:load currentPath="/moduli/finansii" />

  <main class="pt-24">
    <!-- Hero -->
    <section class="relative overflow-hidden py-16 md:py-24">
      <div class="absolute inset-0 bg-gradient-to-br from-primary/5 via-transparent to-[oklch(0.48_0.22_275_/_0.05)]"></div>
      <div class="relative mx-auto max-w-7xl px-6">
        <div class="max-w-3xl">
          <div class="mb-4 inline-flex items-center gap-2 rounded-full bg-primary/10 px-4 py-1.5 text-sm font-semibold text-primary">
            <span class="flex h-6 w-6 items-center justify-center rounded-full bg-primary text-xs font-bold text-white">4</span>
            Модул
          </div>
          <h1 class="text-4xl font-extrabold tracking-tight md:text-5xl lg:text-6xl">
            Секоја фактура, секој трошок.
            <span class="text-gradient"> Знаете точно каде одат парите.</span>
          </h1>
          <p class="mt-6 max-w-2xl text-lg leading-relaxed text-muted-foreground">
            Влезни и излезни фактури, трошоци поврзани со возила, вработени и тури. Сите на едно место.
          </p>
          <a href="/kontakt" class="mt-8 inline-block">
            <button class="rounded-2xl bg-gradient-to-r from-primary to-[oklch(0.48_0.22_275)] px-8 py-3.5 text-sm font-semibold text-white shadow-lg shadow-primary/25 transition-all duration-300 hover:scale-105">
              Закажи демо
            </button>
          </a>
        </div>
      </div>
    </section>

    <!-- Како изгледа тоа во пракса? -->
    <section class="py-16 md:py-20">
      <div class="mx-auto max-w-7xl px-6">
        <h2 class="text-3xl font-extrabold tracking-tight md:text-4xl">Како изгледа тоа во пракса?</h2>
        <div class="mt-10 grid gap-8 md:grid-cols-2">
          <div class="rounded-2xl border border-red-200 bg-red-50/50 p-8">
            <h3 class="mb-4 text-lg font-bold text-red-700">Без Veridex</h3>
            <p class="leading-relaxed text-muted-foreground">
              Сакате да знаете колку ве чинел камионот SK-1234 оваа година. Отворате еден Excel за гориво, друг за сервиси, трет за патарини. Го прашувате сметководителот за фактурите. После два часа собирање бројки, сè уште не сте сигурни дали ви се сите трошоци.
            </p>
          </div>
          <div class="rounded-2xl border border-green-200 bg-green-50/50 p-8">
            <h3 class="mb-4 text-lg font-bold text-green-700">Со Veridex</h3>
            <p class="leading-relaxed text-muted-foreground">
              Го отворате возилото SK-1234 во Veridex. Ги гледате сите трошоци: гориво, патарини, сервиси, казни, осигурување. Секој трошок со датум, износ и категорија. Одговорот го имате за 30 секунди.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Features -->
    <section class="py-20 md:py-28">
      <div class="mx-auto max-w-7xl px-6">
        <div class="mb-16">
          <h2 class="text-3xl font-extrabold tracking-tight md:text-4xl">Што вклучува</h2>
          <p class="mt-4 max-w-2xl text-lg text-muted-foreground">
            Три области за финансиско управување: трошоци, влезни фактури и излезни фактури. Секоја поврзана со остатокот од системот.
          </p>
        </div>

        <div class="grid gap-8 md:grid-cols-3">
          <!-- Трошоци -->
          <div class="rounded-2xl border border-border/50 bg-white p-8">
            <div class="mb-5 flex h-12 w-12 items-center justify-center rounded-2xl bg-primary/10">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18.75a60.07 60.07 0 0 1 15.797 2.101c.727.198 1.453-.342 1.453-1.096V18.75M3.75 4.5v.75A.75.75 0 0 1 3 6h-.75m0 0v-.375c0-.621.504-1.125 1.125-1.125H20.25M2.25 6v9m18-10.5v.75c0 .414.336.75.75.75h.75m-1.5-1.5h.375c.621 0 1.125.504 1.125 1.125v9.75c0 .621-.504 1.125-1.125 1.125h-.375m1.5-1.5H21a.75.75 0 0 0-.75.75v.75m0 0H3.75m0 0h-.375a1.125 1.125 0 0 1-1.125-1.125V15m1.5 1.5v-.75A.75.75 0 0 0 3 15h-.75M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Zm3 0h.008v.008H18V10.5Zm-12 0h.008v.008H6V10.5Z" />
              </svg>
            </div>
            <h3 class="mb-3 text-xl font-bold">Трошоци</h3>
            <p class="mb-4 leading-relaxed text-muted-foreground">
              Секој трошок е поврзан со нешто конкретно: возило, вработен, тура, приколка или компанија. Не е само бројка во табела. Знаете точно за што е потрошен секој денар.
            </p>
            <ul class="space-y-2 text-sm text-muted-foreground">
              <li class="flex items-center gap-2"><div class="h-1.5 w-1.5 rounded-full bg-primary"></div>Поврзаност со возило, вработен, тура, приколка или компанија</li>
              <li class="flex items-center gap-2"><div class="h-1.5 w-1.5 rounded-full bg-primary"></div>Категории и подкатегории (гориво, патарини, сервис, казни...)</li>
              <li class="flex items-center gap-2"><div class="h-1.5 w-1.5 rounded-full bg-primary"></div>Материјали и количини по трошок</li>
              <li class="flex items-center gap-2"><div class="h-1.5 w-1.5 rounded-full bg-primary"></div>Датум, износ и валута</li>
              <li class="flex items-center gap-2"><div class="h-1.5 w-1.5 rounded-full bg-primary"></div>Еден трошок може да биде поврзан со повеќе ентитети истовремено</li>
            </ul>
          </div>

          <!-- Влезни фактури -->
          <div class="rounded-2xl border border-border/50 bg-white p-8">
            <div class="mb-5 flex h-12 w-12 items-center justify-center rounded-2xl bg-primary/10">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 3.75H6.912a2.25 2.25 0 0 0-2.15 1.588L2.35 13.177a2.25 2.25 0 0 0-.1.661V18a2.25 2.25 0 0 0 2.25 2.25h15A2.25 2.25 0 0 0 21.75 18v-4.162c0-.224-.034-.447-.1-.661L19.24 5.338a2.25 2.25 0 0 0-2.15-1.588H15M2.25 13.5h3.86a2.25 2.25 0 0 1 2.012 1.244l.256.512a2.25 2.25 0 0 0 2.013 1.244h3.218a2.25 2.25 0 0 0 2.013-1.244l.256-.512a2.25 2.25 0 0 1 2.013-1.244h3.859M12 3v8.25m0 0-3-3m3 3 3-3" />
              </svg>
            </div>
            <h3 class="mb-3 text-xl font-bold">Влезни фактури</h3>
            <p class="mb-4 leading-relaxed text-muted-foreground">
              Фактури кои ги добивате од добавувачи: сервисери, бензински станици, осигурителни компании. Секоја со свои ставки, рок за плаќање и статус. Кога сервисерот ви испрати фактура, таа се поврзува со записот за одржување на тоа возило.
            </p>
            <ul class="space-y-2 text-sm text-muted-foreground">
              <li class="flex items-center gap-2"><div class="h-1.5 w-1.5 rounded-full bg-primary"></div>Добавувач, датум, рок на плаќање</li>
              <li class="flex items-center gap-2"><div class="h-1.5 w-1.5 rounded-full bg-primary"></div>Детални ставки по фактура</li>
              <li class="flex items-center gap-2"><div class="h-1.5 w-1.5 rounded-full bg-primary"></div>Автоматски статуси: нова, одобрена, платена, задоцнета</li>
              <li class="flex items-center gap-2"><div class="h-1.5 w-1.5 rounded-full bg-primary"></div>Поврзување со запис за одржување на возило</li>
              <li class="flex items-center gap-2"><div class="h-1.5 w-1.5 rounded-full bg-primary"></div>Поврзаност со тура, возило или вработен</li>
            </ul>
          </div>

          <!-- Излезни фактури -->
          <div class="rounded-2xl border border-border/50 bg-white p-8">
            <div class="mb-5 flex h-12 w-12 items-center justify-center rounded-2xl bg-primary/10">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 12 3.269 3.125A59.769 59.769 0 0 1 21.485 12 59.768 59.768 0 0 1 3.27 20.875L5.999 12Zm0 0h7.5" />
              </svg>
            </div>
            <h3 class="mb-3 text-xl font-bold">Излезни фактури</h3>
            <p class="mb-4 leading-relaxed text-muted-foreground">
              Фактури кои ги издавате на клиенти. Поврзани со налози од транспортниот модул. Знаете кој клиент колку ви должи, кои фактури се платени и кои се задоцнети. Не треба да проверувате рачно.
            </p>
            <ul class="space-y-2 text-sm text-muted-foreground">
              <li class="flex items-center gap-2"><div class="h-1.5 w-1.5 rounded-full bg-primary"></div>Поврзаност со налози за тури</li>
              <li class="flex items-center gap-2"><div class="h-1.5 w-1.5 rounded-full bg-primary"></div>Клиент, датум, рок на плаќање</li>
              <li class="flex items-center gap-2"><div class="h-1.5 w-1.5 rounded-full bg-primary"></div>Детални ставки по фактура</li>
              <li class="flex items-center gap-2"><div class="h-1.5 w-1.5 rounded-full bg-primary"></div>Следење на наплата: платена, делумно платена, задоцнета</li>
              <li class="flex items-center gap-2"><div class="h-1.5 w-1.5 rounded-full bg-primary"></div>Автоматско означување на задоцнети фактури</li>
            </ul>
          </div>
        </div>

        <!-- AI: Импорт на трошоци од PDF -->
        <div class="mt-16 rounded-2xl border-2 border-primary/20 bg-gradient-to-br from-primary/5 via-white to-white p-8 md:p-10">
          <div class="mb-4 inline-flex items-center gap-2 rounded-full bg-primary/10 px-3 py-1 text-xs font-semibold text-primary">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904 9 18.75l-.813-2.846a4.5 4.5 0 0 0-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 0 0 3.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 0 0 3.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 0 0-3.09 3.09ZM18.259 8.715 18 9.75l-.259-1.035a3.375 3.375 0 0 0-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 0 0 2.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 0 0 2.455 2.456L21.75 6l-1.036.259a3.375 3.375 0 0 0-2.455 2.456ZM16.894 20.567 16.5 21.75l-.394-1.183a2.25 2.25 0 0 0-1.423-1.423L13.5 18.75l1.183-.394a2.25 2.25 0 0 0 1.423-1.423l.394-1.183.394 1.183a2.25 2.25 0 0 0 1.423 1.423l1.183.394-1.183.394a2.25 2.25 0 0 0-1.423 1.423Z" />
            </svg>
            ВИ
          </div>
          <h3 class="mb-4 text-xl font-bold">Импорт на трошоци од фактури на горивни картички</h3>
          <p class="mb-6 leading-relaxed text-muted-foreground">
            Добивате PDF фактура од DKV или Shell. Наместо рачно да внесувате секоја ставка (гориво, патарини, AdBlue), ВИ ги чита сите трансакции од фактурата. Ги разпознава возилата, датумите, износите и типовите на трошок. Вие само проверувате и кликнувате „Импортирај".
          </p>
          <div class="grid gap-6 md:grid-cols-4">
            <div class="rounded-xl bg-white p-5 text-center">
              <div class="mx-auto mb-3 flex h-10 w-10 items-center justify-center rounded-xl bg-primary/10">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5m-13.5-9L12 3m0 0 4.5 4.5M12 3v13.5" />
                </svg>
              </div>
              <p class="text-xs font-semibold">1. Прикачете PDF</p>
              <p class="mt-1 text-xs text-muted-foreground">Фактура од DKV, Shell или ZIP со повеќе</p>
            </div>
            <div class="rounded-xl bg-white p-5 text-center">
              <div class="mx-auto mb-3 flex h-10 w-10 items-center justify-center rounded-xl bg-primary/10">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904 9 18.75l-.813-2.846a4.5 4.5 0 0 0-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 0 0 3.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 0 0 3.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 0 0-3.09 3.09Z" />
                </svg>
              </div>
              <p class="text-xs font-semibold">2. ВИ ги чита ставките</p>
              <p class="mt-1 text-xs text-muted-foreground">Возило, тип, количина, износ, ДДВ</p>
            </div>
            <div class="rounded-xl bg-white p-5 text-center">
              <div class="mx-auto mb-3 flex h-10 w-10 items-center justify-center rounded-xl bg-primary/10">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 6h9.75M10.5 6a1.5 1.5 0 1 1-3 0m3 0a1.5 1.5 0 1 0-3 0M3.75 6H7.5m3 12h9.75m-9.75 0a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m-3.75 0H7.5m9-6h3.75m-3.75 0a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m-9.75 0h9.75" />
                </svg>
              </div>
              <p class="text-xs font-semibold">3. Проверувате и доделувате</p>
              <p class="mt-1 text-xs text-muted-foreground">Тура, држава, избор на ставки</p>
            </div>
            <div class="rounded-xl bg-white p-5 text-center">
              <div class="mx-auto mb-3 flex h-10 w-10 items-center justify-center rounded-xl bg-primary/10">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
                </svg>
              </div>
              <p class="text-xs font-semibold">4. Импортирате</p>
              <p class="mt-1 text-xs text-muted-foreground">Трошоците се внесени и поврзани</p>
            </div>
          </div>
          <div class="mt-6 rounded-xl bg-white p-5">
            <p class="mb-2 text-sm font-semibold">Што извлекува ВИ од секоја трансакција:</p>
            <div class="grid gap-2 sm:grid-cols-2 lg:grid-cols-3">
              {[
                "Регистарски број на возило",
                "Датум на трансакција",
                "Тип: дизел, AdBlue, патарина",
                "Количина (литри за гориво)",
                "Износ во EUR и ДДВ",
                "Автоматско поврзување со возило и тура",
              ].map((item) => (
                <div class="flex items-center gap-2 text-sm text-muted-foreground">
                  <div class="h-1.5 w-1.5 shrink-0 rounded-full bg-primary"></div>
                  {item}
                </div>
              ))}
            </div>
          </div>
          <div class="mt-6 grid gap-4 md:grid-cols-2">
            <div class="rounded-xl bg-red-50/50 p-5">
              <p class="mb-1 text-sm font-semibold text-red-700">Рачно (без ВИ)</p>
              <p class="text-sm text-muted-foreground">Една DKV фактура со 40 ставки. Секоја ставка ја внесувате рачно: возило, тип, датум, износ. Ви треба 30 до 60 минути.</p>
            </div>
            <div class="rounded-xl bg-green-50/50 p-5">
              <p class="mb-1 text-sm font-semibold text-green-700">Со ВИ импорт</p>
              <p class="text-sm text-muted-foreground">Прикачувате PDF, ВИ ги чита сите 40 ставки. Проверувате, кликнувате „Импортирај". Готово за 2 минути.</p>
            </div>
          </div>
        </div>

        <!-- Сè е поврзано -->
        <div class="mt-16 rounded-2xl border border-border/50 bg-muted/30 p-8 md:p-10">
          <h3 class="mb-4 text-xl font-bold">Сè е поврзано</h3>
          <p class="mb-6 leading-relaxed text-muted-foreground">
            Трошоците и фактурите не се изолирани записи во табела. Секој е поврзан со конкретно возило, вработен, тура или компанија. Тоа значи дека можете да отворите кој било ентитет и да ги видите сите негови финансиски податоци.
          </p>
          <div class="grid gap-6 md:grid-cols-2">
            <div class="rounded-xl bg-white p-6">
              <p class="mb-2 text-sm font-semibold">Пример 1: Возило SK-1234</p>
              <p class="text-sm text-muted-foreground">
                Отворете го возилото SK-1234 и ги гледате сите трошоци: гориво, патарини, сервиси, казни. Знаете колку ве чинел тој камион за цела година. Не барате по Excel табели.
              </p>
            </div>
            <div class="rounded-xl bg-white p-6">
              <p class="mb-2 text-sm font-semibold">Пример 2: Тура TU-0045</p>
              <p class="text-sm text-muted-foreground">
                Отворете ја турата TU-0045 и ги гледате: приходи од 3 налози минус сите трошоци (гориво, патарини, дневници). Профитот на таа тура го знаете веднаш.
              </p>
            </div>
          </div>
          <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
            {["Трошоци по возило", "Трошоци по вработен", "Расходи по компанија", "Трошоци по приколка", "Финансии по тура"].map((item) => (
              <div class="flex items-center gap-2 rounded-xl bg-white px-4 py-3">
                <div class="h-2 w-2 shrink-0 rounded-full bg-primary"></div>
                <span class="text-sm font-medium">{item}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Illustration -->
    <section class="py-8">
      <div class="mx-auto max-w-7xl px-6">
        <img src="/images/module-finansii.svg" alt="Финансии модул" class="mx-auto mt-12 w-full max-w-2xl" />
      </div>
    </section>

    <!-- CTA -->
    <section class="bg-muted/30 py-20 md:py-28">
      <div class="mx-auto max-w-3xl px-6 text-center">
        <h2 class="text-3xl font-extrabold tracking-tight md:text-4xl">
          Сакате да знаете точно
          <span class="text-gradient"> каде одат парите?</span>
        </h2>
        <p class="mx-auto mt-6 max-w-xl text-lg text-muted-foreground">
          Закажете бесплатна демонстрација и ќе ви покажеме како изгледа кога секој трошок и секоја фактура се поврзани со конкретно возило, тура или вработен.
        </p>
        <a href="/kontakt" class="mt-8 inline-block">
          <button class="group relative overflow-hidden rounded-2xl bg-gradient-to-r from-primary to-[oklch(0.48_0.22_275)] px-10 py-4 text-lg font-semibold text-white shadow-2xl shadow-primary/30 transition-all duration-300 hover:scale-105">
            <span class="relative z-10">Закажи демо</span>
