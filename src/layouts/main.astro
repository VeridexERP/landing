---
import "@/styles/global.css"

interface Props {
  title?: string
  description?: string
  ogImage?: string
}

const {
  title = "Veridex ERP | Возила, возачи, тури и фактури на едно место",
  description = "Veridex ERP за транспортни компании. Возила, возачи, тури и фактури на едно место. Направено во Македонија, на македонски.",
  ogImage = "/images/og.png",
} = Astro.props

const siteUrl = "https://veridexerp.com"
const canonicalUrl = `${siteUrl}${Astro.url.pathname}`
const ogImageUrl = `${siteUrl}${ogImage}`

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      name: "Veridex ERP",
      description: "ERP систем за транспортни компании. Возила, возачи, тури и фактури на едно место.",
      applicationCategory: "BusinessApplication",
      operatingSystem: "Web",
      url: siteUrl,
      inLanguage: "mk",
      offers: {
        "@type": "AggregateOffer",
        priceCurrency: "EUR",
        lowPrice: "12",
        highPrice: "22",
        offerCount: "4",
      },
    },
    {
      "@type": "Organization",
      name: "Veridex",
      url: siteUrl,
      email: "info@veridex.mk",
      logo: `${siteUrl}/images/logo.png`,
    },
  ],
}
---

<html lang="mk">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="description" content={description} />
    <title>{title}</title>

    <!-- Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- Google Analytics (GA4) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-XXXXXXXXXX"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-XXXXXXXXXX');
    </script>

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Veridex ERP" />
    <meta property="og:locale" content="mk_MK" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
  </head>
  <body>
    <slot />
  </body>
</html>
